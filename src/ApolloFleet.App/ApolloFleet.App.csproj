<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>ApolloFleet.App</RootNamespace>
    <AssemblyName>ApolloFleet.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Product>Apollo Fleet Launcher</Product>
    <AssemblyTitle>Apollo Fleet Launcher</AssemblyTitle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <PackageReference Include="TaskScheduler" Version="2.11.0" />
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ApolloFleet.Core\ApolloFleet.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="i18n\Resources*.resx" />
  </ItemGroup>

  <Target Name="OrganizeI18nOutput" AfterTargets="Build;Publish">
    <ItemGroup>
      <_I18nResx Include="i18n\Resources*.resx" />
    </ItemGroup>

    <MakeDir Directories="$(OutDir)i18n" />
    <Copy SourceFiles="@(_I18nResx)"
          DestinationFiles="@(_I18nResx->'$(OutDir)i18n\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$root='$(OutDir)'; $i18n=Join-Path $root 'i18n'; New-Item -ItemType Directory -Force -Path $i18n | Out-Null; Get-ChildItem -Path $root -Directory | Where-Object { $_.Name -match '^[a-z]{2}(-[A-Za-z0-9]{2,8})?$' -and $_.Name -ne 'i18n' } | ForEach-Object { $dst=Join-Path $i18n $_.Name; if (Test-Path $dst) { Remove-Item -Recurse -Force $dst }; Move-Item -Path $_.FullName -Destination $dst }&quot;" />
  </Target>
</Project>
